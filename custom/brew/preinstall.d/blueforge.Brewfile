# BlueForge's OS-managed user toolchain.
# Bluefin's brew-preinstall.service installs this at first login and reconciles
# additions/removals after image updates.

# Third-party taps must be explicitly trusted with Homebrew 6+.
tap "anomalyco/tap", trusted: true

# Daily command-line tools
brew "bat"
brew "direnv"
brew "eza"
brew "fd"
brew "gh"
brew "lazygit"
brew "mise"
brew "neovim"
brew "ripgrep"
brew "uv"

# Local runtimes and container workflow
brew "devcontainer"
brew "node"
brew "vite-plus"

# AI coding tools
brew "anomalyco/tap/opencode"
