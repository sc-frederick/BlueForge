# Optional host-native build tools.
# Install with `ujust install-dev-tools` for projects that intentionally build
# on the host. Language versions should normally be declared per repository
# with mise, uv, or the language's own toolchain file.

brew "ccache"
brew "cmake"
brew "hyperfine"
brew "ninja"
brew "shellcheck"
brew "shfmt"
brew "watchexec"
